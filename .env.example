# Copia este archivo como .env y ajusta los valores.

# Clave para firmar las sesiones. Usa un texto largo y aleatorio.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# 0.0.0.0 permite que otros equipos de la red interna entren a la app.
HOST=0.0.0.0
PORT=8000

TIMEZONE=America/Mexico_City
SESSION_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
SLA_DIAS_HABILES=2
PAGE_SIZE=25

# Respaldos diarios del archivo SQLite (cuántos conservar).
BACKUP_KEEP=14
MAX_UPLOAD_MB=5

# Correo. Con MAIL_ENABLED=false los correos se guardan en la carpeta outbox/.
MAIL_ENABLED=false
MAIL_HOST=smtp.tuempresa.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=FX Onboarding <no-responder@tuempresa.com>
MAIL_TIMEOUT=15
